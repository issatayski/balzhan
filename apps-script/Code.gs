function setupSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET);
  if (!sh) sh = ss.insertSheet(SHEET);
  sh.clear();

  sh.getRange(1, 1, 1, COLS.length).setValues([COLS])
    .setFontWeight('bold').setBackground('#1F3864').setFontColor('#FFFFFF');
  sh.setFrozenRows(1);

  var rows = SEED.map(function (d, i) {
    return ['D' + ('0' + (i + 1)).slice(-2), d[0], d[1], d[2], d[3], d[4],
            '', '', '', '', '', '', '', '', d[5], ''];
  });
  sh.getRange(2, 1, rows.length, COLS.length).setValues(rows);

  sh.setColumnWidth(1, 55);
  sh.setColumnWidth(4, 330);
  sh.setColumnWidth(6, 130);
  sh.setColumnWidth(7, 200);
  sh.setColumnWidth(14, 200);
  sh.setColumnWidth(15, 230);
  sh.getRange(2, 1, rows.length, COLS.length).setFontFamily('Arial').setFontSize(10);
  SpreadsheetApp.getUi().alert('Готово: записано дисциплин — ' + rows.length);
}

function sheet_() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET);
  if (!sh) throw new Error('Лист «' + SHEET + '» не найден. Запустите setupSheet().');
  return sh;
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function yes_(v) {
  return v === true || v === 'да' || v === 'ДА' || v === 'TRUE';
}

function doGet(e) {
  try {
    var sh = sheet_();
    var last = sh.getLastRow();
    if (last < 2) return json_({ok: true, rows: []});
    var vals = sh.getRange(2, 1, last - 1, COLS.length).getValues();
    var rows = vals.map(function (v) {
      return {
        id: String(v[0]), course: Number(v[1]), sem: Number(v[2]),
        name: String(v[3]), credits: Number(v[4]), type: String(v[5]),
        work: String(v[6] || ''),
        src: yes_(v[7]), shot: yes_(v[8]), pdf: yes_(v[9]), desc: yes_(v[10]),
        grade: String(v[11] || ''), folder: String(v[12] || ''),
        notes: String(v[13] || ''), note: String(v[14] || ''),
        updated: v[15] ? String(v[15]) : ''
      };
    });
    return json_({ok: true, rows: rows});
  } catch (err) {
    return json_({ok: false, error: String(err.message || err)});
  }
}

function doPost(e) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
    var body = JSON.parse(e.postData.contents);
    if (body.action !== 'update') return json_({ok: false, error: 'неизвестное действие'});

    var sh = sheet_();
    var last = sh.getLastRow();
    var ids = sh.getRange(2, 1, last - 1, 1).getValues();
    var target = -1;
    for (var i = 0; i < ids.length; i++) {
      if (String(ids[i][0]) === String(body.id)) { target = i + 2; break; }
    }
    if (target < 0) return json_({ok: false, error: 'строка не найдена: ' + body.id});

    var f = body.fields || {};
    for (var key in f) {
      if (!WRITABLE.hasOwnProperty(key)) continue;
      var val = f[key];
      if (typeof val === 'boolean') val = val ? 'да' : '';
      sh.getRange(target, WRITABLE[key]).setValue(val);
    }
    sh.getRange(target, 16).setValue(new Date());
    return json_({ok: true, id: body.id});
  } catch (err) {
    return json_({ok: false, error: String(err.message || err)});
  } finally {
    try { lock.releaseLock(); } catch (x) {}
  }
}
